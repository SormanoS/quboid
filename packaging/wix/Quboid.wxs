<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Quboid"
    Manufacturer="Quboid contributors"
    Version="$(var.Version)"
    UpgradeCode="{87C56635-D3B0-4E65-9877-B97FF7BE60D5}"
    Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Quboid is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- An upgrade replaces the executable without stopping what is running,
         and Quboid lives in the tray where nobody thinks to close it. The old
         process keeps every global shortcut it registered, so the new one
         would start powerless. Stop it before the files are swapped. -->
    <util:CloseApplication
      Id="CloseRunningQuboid"
      Target="quboid-app.exe"
      CloseMessage="no"
      TerminateProcess="0"
      RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Quboid" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="MainFeature" Title="Quboid" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="QuboidExe" Source="$(var.SourceDir)\quboid-app.exe" KeyPath="yes">
        <Shortcut
          Id="StartMenuShortcut"
          Directory="ProgramMenuFolder"
          Name="Quboid"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="no" />
      </File>
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>
  </Package>
</Wix>
