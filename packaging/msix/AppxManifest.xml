<?xml version="1.0" encoding="utf-8"?>

<!--
  Package identity for the Microsoft Store.

  Name, Publisher and PublisherDisplayName are the values Partner Center
  assigned to the reserved "Quboid" name and must be reproduced exactly:
  a package whose identity disagrees with them is rejected on upload.
  The Publisher is a per-account identifier, not a certificate the developer
  holds; the Store signs the package to match it. scripts\package-msix.ps1
  rewrites Version from the workspace manifest and can override identity for
  local experiments.

  The application runs at full trust. A packaged full-trust desktop app is
  not placed in an app container, so global hooks, RegisterHotKey and the
  window manipulation Quboid relies on behave as they do unpackaged, and
  neither the registry nor %APPDATA% is virtualised. Writes to %APPDATA% are
  redirected into the package's LocalCache, which reads fall through to the
  real folder until the first write, so an existing installation's settings
  carry over.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="SamueleSormano.Quboid"
    Publisher="CN=07B33FD2-681B-4258-A3B1-56423067842B"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Quboid</DisplayName>
    <PublisherDisplayName>Samuele Sormano</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 22H2 is the oldest release Quboid targets. -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19045.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="it-it" />
  </Resources>

  <Applications>
    <Application
      Id="Quboid"
      Executable="quboid-app.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Quboid"
        Description="Move and resize windows with keyboard shortcuts and drag snapping."
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          Launch at login for a packaged build. The HKCU Run key that
          startup.rs writes is not the supported mechanism here: Windows
          drives this task instead, and the user can disable it from Task
          Manager. Enabled="false" leaves the choice to the app, which
          toggles it through Windows.ApplicationModel.StartupTask.
        -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask
            TaskId="QuboidStartup"
            Enabled="false"
            DisplayName="Quboid" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
